FROM nousresearch/hermes-agent:latest

USER root

# System tools for development, automation, git workflows
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssh-client \
    curl \
    wget \
    jq \
    ca-certificates \
    gnupg \
    && rm -rf /var/lib/apt/lists/
# GitHub CLI
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
    | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
    | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/

# Python extras via uv (into the existing venv)
RUN uv pip install --python /opt/hermes/.venv/bin/python3 \
    pygount \
    jupyterlab \
    youtube-transcript-api \
    "markitdown[pptx]" \
    Pillow \
    python-docx \
    paramiko

# Support running under arbitrary UIDs (e.g. macOS UID 501).
# OpenSSH's getpwuid() requires a valid /etc/passwd entry for the running UID.
# The upstream entrypoint (docker/entrypoint.sh) handles this via HERMES_UID
# env var when the container starts as root — it runs usermod + gosu.
# This fallback ensures SSH works even if the entrypoint gosu flow is bypassed
# (e.g. docker-compose user: directive) or when running the image directly.
ARG TARGET_UID=501
RUN if ! getent passwd "$TARGET_UID" >/dev/null 2>&1; then \
      echo "hermes:x:${TARGET_UID}:${TARGET_UID}::/opt/data:/bin/sh" >> /etc/passwd; \
    fi

USER root
